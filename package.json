{
  "name": "fuse-napi",
  "version": "v1.0.0",
  "description": "Node-API bindings for FUSE 2.9 on Linux and macOS",
  "keywords": [
    "fuse",
    "filesystem",
    "napi",
    "native-addon",
    "linux",
    "macos",
    "macfuse"
  ],
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "README.md",
    "RELEASING.md",
    "SECURITY.md",
    "UPSTREAM.md",
    "binding.gyp",
    "fuse-native.c",
    "index.d.ts",
    "index.js",
    "lib/macfuse.js",
    "prebuilds/",
    "scripts/fuse-config.js",
    "scripts/verify-release.js"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "nanoresource": "^1.3.0",
    "napi-macros": "^2.2.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concat-stream": "^2.0.0",
    "prebuildify": "^6.0.1",
    "tape": "^5.10.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmdevries/fuse-napi.git"
  },
  "author": "Matthijs de Vries",
  "contributors": [
    {
      "name": "Mathias Buus",
      "url": "https://github.com/mafintosh"
    },
    {
      "name": "SageMath, Inc."
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmdevries/fuse-napi/issues"
  },
  "homepage": "https://github.com/mmdevries/fuse-napi#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "node --check index.js && node --check example.js && node --check lib/macfuse.js && node --check scripts/fuse-config.js && node --check scripts/verify-release.js",
    "install": "node-gyp-build",
    "test": "tape test/*.js",
    "test:unit": "tape test/dependencies.js test/errno.js test/hardening.js test/mount-ready.js test/options.js test/release.js",
    "test:types": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules build",
    "prebuild": "prebuildify --napi --strip",
    "verify:metadata": "node scripts/verify-release.js",
    "verify:release": "node scripts/verify-release.js --artifacts",
    "prepublishOnly": "node scripts/verify-release.js --artifacts"
  }
}
